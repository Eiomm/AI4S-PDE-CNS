{
  "type": "object",
  "required": ["decision", "files", "code_artifacts", "experiment_plan"],
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "object",
      "required": ["route", "reason", "expected_gain", "risk"],
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string",
          "description": "本轮选择的 Task1 路线，例如 official_fno、official_unet_pf20、official_ensemble、finetune_fno。"
        },
        "reason": {
          "type": "string",
          "description": "为什么选择这个路线，必须基于 memory packet 和当前约束。"
        },
        "expected_gain": {
          "type": "string",
          "description": "相对当前 best candidate 预期改进点。"
        },
        "risk": {
          "type": "string",
          "description": "本轮最主要失败风险。"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "相对 agent_workspace/code 的路径，不允许绝对路径或 ..。"
          },
          "content": {
            "type": "string",
            "description": "Agent 独立生成的完整文件内容。"
          }
        }
      }
    },
    "planned_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "建议 runner 或人类下一步执行的命令。首选只写 validation / memory export / 受控工具命令。"
    },
    "code_artifacts": {
      "type": "object",
      "required": ["primary_role", "entrypoints", "experiment_traceability", "limitations"],
      "additionalProperties": false,
      "properties": {
        "primary_role": {
          "type": "string",
          "enum": ["research_planning", "baseline_replay", "checkpoint_finetune", "prediction_validation", "log_compliance", "submission_packaging"],
          "description": "本轮生成代码在工作流里的主要角色。进入 checkpoint_finetune 时不能只写 manifest/readme。"
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "role", "is_executable"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "必须对应 files[].path 中的一个文件。"
              },
              "role": {
                "type": "string",
                "enum": ["train", "predict", "validate", "package", "analyze", "manifest"],
                "description": "该文件承担的核心职责。"
              },
              "is_executable": {
                "type": "boolean",
                "description": "是否可作为脚本入口运行；核心训练/推理代码必须为 true。"
              },
              "linked_tool": {
                "type": "string",
                "enum": ["none", "data_shape_check", "checkpoint_replay", "finetuned_checkpoint_replay", "finetune_local", "validation", "llm_log_prepare", "submission_package"],
                "description": "该文件对应或复现的白名单 tool。"
              }
            }
          },
          "description": "本轮 code/ 中真正可追溯的入口文件列表。"
        },
        "experiment_traceability": {
          "type": "string",
          "description": "说明这些代码如何对应本轮 tool_requests、checkpoint、数据尺度和实验参数。"
        },
        "limitations": {
          "type": "string",
          "description": "说明当前代码还不能覆盖的部分，避免把说明性文件伪装成完整训练实现。"
        }
      },
      "description": "Agent 生成代码的产物契约，用于防止只生成 README/manifest 而没有实验核心代码。"
    },
    "tool_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "purpose"],
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "enum": ["web_search", "optuna", "ray_tune", "wandb", "validation", "checkpoint_replay", "finetuned_checkpoint_replay", "finetune_local", "memory_query", "data_shape_check", "llm_log_prepare", "submission_package"]
          },
          "purpose": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "description": "web_search 使用的检索问题。"
          },
          "budget": {
            "type": "string",
            "description": "实验或检索预算，例如 max_trials=8、timeout=2h、top_k=5。"
          },
          "target": {
            "type": "string",
            "description": "checkpoint_replay 目标，例如 official_fno / official_unet_pf20 / official_ensemble。"
          },
          "route": {
            "type": "string",
            "description": "可选路线过滤或 replay 路线。"
          },
          "split": {
            "type": "string",
            "enum": ["val", "test"],
            "description": "checkpoint_replay 或 validation 使用的数据 split。"
          },
          "run_name": {
            "type": "string",
            "description": "可选 run 名称。"
          },
          "run_dir": {
            "type": "string",
            "description": "finetune_local 请求来源备注，finetuned_checkpoint_replay 的微调 run 目录，或 submission_package 使用的已完成 run 目录。executor 会统一写入 runs/task1/<agent_run_id>__toolXX，不会使用描述性目录名。"
          },
          "checkpoint": {
            "type": "string",
            "description": "finetuned_checkpoint_replay 使用的 FNO checkpoint 路径；不填且提供 run_dir 时默认使用 run_dir/best.pt；同一轮前序 finetune_local 已成功时也可不填。"
          },
          "checkpoint_path": {
            "type": "string",
            "description": "checkpoint 字段别名，用于 finetuned_checkpoint_replay。"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "data_shape_check 要检查的 HDF5 路径列表；不填则检查 Task1 test/val/raw train 三个关键文件。"
          },
          "prediction": {
            "type": "string",
            "description": "validation 使用的 prediction HDF5 路径。"
          },
          "input": {
            "type": "string",
            "description": "validation 使用的输入 HDF5 路径。"
          },
          "target_hdf5": {
            "type": "string",
            "description": "validation 使用的 target HDF5 路径，避免和 replay target 混淆。"
          },
          "output": {
            "type": "string",
            "description": "validation report 或 llm_log_prepare 输出路径。"
          },
          "input_logs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "llm_log_prepare 输入的 proxy JSONL 文件列表；不填则使用 logs/ 下最新 openai_proxy_*.jsonl。"
          },
          "llm_log": {
            "type": "string",
            "description": "submission_package 使用的合规 task1_logs.log 路径。"
          },
          "code_dir": {
            "type": "string",
            "description": "submission_package 使用的 Agent code 快照目录；不填则读取最新 summary.generated_code_root。"
          },
          "submission_name": {
            "type": "string",
            "description": "submission_package 输出目录名；不填则使用 <agent_run_id>__toolXX_submission。"
          },
          "submission_id": {
            "type": "string",
            "description": "submission.json 中的 submission_id。"
          },
          "max_chars": {
            "type": "integer",
            "description": "memory_query 最大输出字符数。"
          },
          "promote_slot": {
            "type": "string",
            "description": "checkpoint_replay 后可选 promotion slot。"
          },
          "objective": {
            "type": "string",
            "description": "optuna 目标。当前 executor 只支持 ensemble_weights。"
          },
          "metric": {
            "type": "string",
            "description": "optuna 或 validation 使用的指标名，默认 competition_score_proxy。"
          },
          "direction": {
            "type": "string",
            "enum": ["maximize", "minimize"],
            "description": "optuna 优化方向。"
          },
          "study_name": {
            "type": "string",
            "description": "optuna study 名称。"
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local 训练步数。建议 cheap probe 先用 100-500。"
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local 训练 batch size。"
          },
          "eval_batch_size": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local validation batch size。"
          },
          "lr": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "finetune_local 学习率，官方 checkpoint 微调建议 1e-5 到 5e-5。"
          },
          "weight_decay": {
            "type": "number",
            "minimum": 0,
            "description": "finetune_local weight decay。"
          },
          "rollout_steps": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local 训练 unroll 步数。建议从 1 或 2 开始。"
          },
          "horizon_gamma": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "finetune_local rollout loss horizon decay。"
          },
          "trainable": {
            "type": "string",
            "enum": ["head", "last-block-head", "all", "custom"],
            "description": "finetune_local 可训练 preset；若设置 trainable_modules，则模块列表优先。"
          },
          "trainable_modules": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["fc0", "conv0", "w0", "conv1", "w1", "conv2", "w2", "conv3", "w3", "fc1", "fc2"]
            },
            "description": "finetune_local 自由模块选择。传入后覆盖 trainable preset，例如 [\"conv2\", \"w2\", \"conv3\", \"w3\", \"fc1\", \"fc2\"]。"
          },
          "max_samples": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local 训练样本上限。"
          },
          "val_max_samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "finetune_local 验证样本上限。Task1 本地验证集只有 100 条，executor 会把更大的请求截断到 100。"
          },
          "val_every": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local 每多少 step 做一次 validation。"
          },
          "log_every": {
            "type": "integer",
            "minimum": 1,
            "description": "finetune_local 每多少 step 写一次训练日志。"
          },
          "device": {
            "type": "string",
            "description": "finetune_local 设备，例如 cuda、cuda:0 或 cpu。"
          }
        }
      },
      "description": "Agent 请求下一轮可调用的工具。runner 后续只会执行白名单工具。"
    },
    "experiment_plan": {
      "type": "object",
      "required": ["stage", "workflow_module", "budget", "time_budget", "score_tradeoff"],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["baseline", "cheap_probe", "search", "promotion", "submission"]
        },
        "workflow_module": {
          "type": "string",
          "enum": ["rules_read", "data_shape_check", "baseline_replay", "checkpoint_finetune", "prediction_validation", "log_compliance", "submission_packaging"],
          "description": "本轮主要执行或修复的 Skill/Workflow 模块。"
        },
        "parallel_trials": {
          "type": "integer",
          "minimum": 1
        },
          "budget": {
            "type": "string"
          },
          "time_budget": {
            "type": "string",
            "description": "本轮预计训练/推理时间预算与停止依据，例如 train<=45min, inference<=120s, stop if val gain < 0.5 after 2 evals。"
          },
          "score_tradeoff": {
            "type": "string",
            "description": "说明本轮如何权衡预测精度、训练耗时和推理耗时；不能只追求 validation 分数。"
          },
          "early_stop": {
            "type": "string"
        },
        "promotion_rule": {
          "type": "string"
        }
      },
      "description": "多轮探索计划。默认先 cheap probe，再少量 promotion，不要并发完整训练。"
    },
    "memory_update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypothesis": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
