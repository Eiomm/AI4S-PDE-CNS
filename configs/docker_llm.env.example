# Docker-baked LLM key configuration.
# Copy this file to configs/docker_llm.env and replace the key before building
# the final competition image. The Dockerfile checks that the placeholder is gone.

CHEM_EVOLVE_LLM_ENABLED=1

# API type is the same as local testing. This only separates the Docker key.
AI4S_AGENT_API_KEY_ENVS=DOCKER_LLM_API_KEY
DOCKER_LLM_API_KEY=<your-docker-llm-api-key>

# Optional overrides. Leave commented to use Dockerfile defaults.
# AI4S_AGENT_PROVIDER=openai
# AI4S_AGENT_MODEL=openai/claude-opus-4-8
# AI4S_AGENT_BASE_URL=https://api.gpt.ge/v1
AI4S_AGENT_TEMPERATURE=0.4
AI4S_AGENT_MAX_TOKENS=1600
AI4S_AGENT_MAX_RETRIES=3
AI4S_AGENT_BYPASS_PROXY=1
LITELLM_LOCAL_MODEL_COST_MAP=True
