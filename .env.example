APIFOX_GPT_GE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
AIGC_API_KEY=
VAPI_API_KEY=
HKUSTGZ_AIGC_API_KEY=
KIMI_CODE_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=

# Local logging proxy, matching the referenced AI4S-PDE-CNS Task1 .env style.
AI4S_PROXY_PORT=8080
AI4S_PROXY_TARGET=https://api.gpt.ge
AI4S_PROXY_LOG_DIR=./logs

# Chem-Evolve LiteLLM agent defaults.
# Third-party OpenAI-compatible route used by the referenced PDE project.
AI4S_AGENT_MODEL=openai/claude-opus-4-8
AI4S_AGENT_PROVIDER=openai
AI4S_AGENT_BASE_URL=https://api.gpt.ge/v1
AI4S_AGENT_TEMPERATURE=0.4
AI4S_AGENT_MAX_TOKENS=1600
AI4S_AGENT_MAX_RETRIES=3
AI4S_AGENT_MAX_CONCURRENT_PER_KEY=2
AI4S_AGENT_API_KEY_ENVS=APIFOX_GPT_GE_API_KEY,OPENAI_API_KEY,ANTHROPIC_API_KEY,VAPI_API_KEY,AIGC_API_KEY,HKUSTGZ_AIGC_API_KEY,KIMI_CODE_API_KEY,KIMI_API_KEY,MOONSHOT_API_KEY,SILICONFLOW_API_KEY
# CLI runs set LLM logs to the current output directory by default.
# Set this only when you intentionally want a custom persistent LLM audit log path.
# AI4S_AGENT_LLM_LOG_DIR=/path/to/custom/llm_io
AI4S_PROVIDER_RAW_DEBUG=0
AI4S_AGENT_BYPASS_PROXY=1
LITELLM_LOCAL_MODEL_COST_MAP=True

# Chem-Evolve-specific switch. Set to 0 for deterministic smoke runs.
CHEM_EVOLVE_LLM_ENABLED=1

# Persistent cross-run agent experience. CLI/harness default to outputs/agent_experience.jsonl.
# Set this when you want multiple output roots to share the same evaluated-candidate memory.
# AI4S_AGENT_MEMORY_FILE=outputs/agent_experience.jsonl
AI4S_AGENT_MEMORY_LIMIT=10

# Agent tool wiring. Route planning uses AiZynthFinder only; no template fallback.
AI4S_ROUTE_ENGINE=aizynthfinder
AIZYNTHFINDER_CONFIG=data/aizynthfinder/config.yml
AI4S_ROUTE_LIMIT_PER_ROUND=10
AI4S_VINA_FEEDBACK_PER_ROUND=1

# Optional external SBDD generator. The command must write AI4S_OUTPUT_SMILES.
# AI4S_SBDD_GENERATOR_CMD=/path/to/your/sbdd_adapter.sh
